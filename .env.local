# Backend API URL (server-side calls, not exposed to browser)
BACKEND_URL=http://localhost:3001

# Public API URL — used by both server components AND client components.
# Local dev: localhost works for both.
# Production: must be set to your actual public API URL e.g. https://thesoloakash.com/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api
